{
  "schemaVersion": 1,
  "slug": "vercel",
  "name": "Vercel",
  "description": "Inspect projects, deployments, and runtime logs.",
  "categories": [
    "developer"
  ],
  "featured": true,
  "branding": {
    "logoUrl": "/brands/apps/vercel.svg",
    "darkLogoUrl": "/brands/apps/vercel-dark.svg"
  },
  "urlPatterns": [
    "https://mcp.vercel.com/*"
  ],
  "docsUrl": "https://vercel.com/docs/rest-api",
  "redirectConstraints": "https-or-loopback-http",
  "methods": [
    {
      "key": "mcp-oauth",
      "transport": "mcp_remote",
      "auth": "oauth",
      "ownershipModes": [
        "customer",
        "dcr"
      ],
      "whenToUse": "Use browser sign-in for the provider-hosted MCP server.",
      "defaults": {
        "serverUrl": "https://mcp.vercel.com/mcp"
      },
      "guidanceMd": "Connect the Vercel team and projects agents should operate.",
      "riskTier": "S3",
      "requiredResourceFilters": [
        "team",
        "project",
        "environment"
      ]
    },
    {
      "key": "mcp-api-key",
      "transport": "mcp_remote",
      "auth": "api_key",
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "Use a Vercel personal access token or team token.",
      "defaults": {
        "serverUrl": "https://mcp.vercel.com/mcp"
      },
      "guidanceMd": "Create an Access Token in Vercel Account Settings > Tokens and configure team/project scope.",
      "riskTier": "S3",
      "label": "Use an API token",
      "consoleLinks": {
        "register": "https://vercel.com/account/tokens",
        "docs": "https://vercel.com/docs/rest-api"
      },
      "credentialFields": [
        {
          "key": "authorization",
          "label": "Vercel Access Token",
          "type": "password",
          "required": true,
          "placeholder": "Bearer token from Vercel Account Settings > Tokens",
          "secretRef": "company_secrets"
        }
      ],
      "keyPlacement": {
        "location": "header",
        "name": "Authorization",
        "prefix": "Bearer "
      },
      "requiredResourceFilters": [
        "team",
        "project",
        "environment"
      ]
    }
  ],
  "availability": {
    "available": false,
    "reason": "Blocked pending Vercel Connect pilot review."
  }
}
